{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx", "vite.config.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/test/**"],
  "ignoreDependencies": ["tailwindcss", "autoprefixer", "postcss"],
  "includeEntryExports": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "enumMembers": "off"
  }
}
